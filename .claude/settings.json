{
  "$comment": "Project settings. Hooks: guard_write.py confines subagent writes to .claude/role-write-paths.json; guard_browser.py confines browser navigation to designs/ and the local review server. The retired harness configuration is archived under _archive/harness-3.2.0/dot-claude/. Precedence is deny > ask > allow.",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Write(./_archive/**)",
      "Edit(./_archive/**)",
      "Bash(curl:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__file_upload",
      "mcp__claude-in-chrome__upload_image",
      "mcp__claude-in-chrome__form_input",
      "mcp__claude-in-chrome__gif_creator",
      "mcp__claude-in-chrome__shortcuts_execute",
      "mcp__claude-in-chrome__shortcuts_list",
      "mcp__claude-in-chrome__select_browser",
      "mcp__claude-in-chrome__switch_browser",
      "mcp__claude-in-chrome__read_network_requests"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(gh pr create:*)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.json)"
    ],
    "allow": [
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(uv run --no-cache:*)",
      "Bash(python3 scripts/serve_prototype.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_write.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      },
      {
        "matcher": "mcp__Claude_Browser__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_browser.py\""
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_browser.py\""
          }
        ]
      }
    ]
  }
}
