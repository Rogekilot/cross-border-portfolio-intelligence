  "format": {
    "decimals": "Every quantity, amount, cost basis, split component and expected numeric value is a JSON STRING holding a plain decimal literal (no exponent, no thousands separator), to be parsed with decimal.Decimal(str). Never parse as float. Compare expected and actual by Decimal numeric equality (Decimal('7500') == Decimal('7500.00')), not by string equality.",
    "money": "An object {\"amount\": <decimal string>, \"currency\": <3-letter code>}.",
    "dates": "ISO 8601 calendar dates (YYYY-MM-DD). No times.",
    "ids": "UUID strings. They are fixed so that runs are comparable; they carry no meaning.",
    "events": "Each entry is {\"ledger_seq\": int, \"event\": {...}}. The event object uses exactly the field names of domain.ledger.LedgerEvent. A field that is absent is None. split_ratio is {\"new_units\": str, \"old_units\": str}. ledger_seq is the per-portfolio, storage-assigned order. Events sharing an \"atomic_group\" value must be appended in one transaction, in ledger_seq order. \"atomic_group\" is a loader instruction, not a LedgerEvent field.",
    "assertions": "Each assertion gives as_of (D, inclusive) and ledger_version (L). Each entry in \"expect\" names one value, its scope and its expected MetricResult envelope: state, value (null iff state is INSUFFICIENT_DATA), reason (a ReasonCode name or null) and detail (the complete, sorted list of ReplayDetail names, or [] when AVAILABLE). detail null means NOT ASSERTED: do not check the detail for that value. It is used only where the reason code fully determines the cause (1.1).",
    "expect_kinds": {
      "account_status": "value is RECONSTRUCTED or NOT_RECONSTRUCTABLE (AccountStatus). Carries no state, reason or detail. An optional snapshot_date (ISO date, or null) asserts the account's snapshot date S when present (1.1).",
      "quantity": "The account-level position quantity for (account, listing). \"0\" AVAILABLE means the reconstructed account holds none.",
      "basis": "The account-level total cost basis for (account, listing). When AVAILABLE, value is a list of money objects, one per basis currency, sorted by currency code. An empty list with quantity 0 means no position.",
      "cash": "The account-level cash for (account, currency), signed. \"0\" AVAILABLE means none.",
      "portfolio_cash": "The sum over the portfolio's accounts for ONE currency. There is no cross-currency total anywhere (T9).",
      "portfolio_quantity": "The sum over the portfolio's accounts for ONE listing."
    }
  },
